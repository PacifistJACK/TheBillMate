# ─────────────────────────────────────────────────────────
# .env.example — Safe template to commit to version control
# Copy this file to .env and fill in the real values
# NEVER commit the actual .env file (it's in .gitignore)
# ─────────────────────────────────────────────────────────

# SambaNova API (get from https://cloud.sambanova.ai)
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# MongoDB Atlas connection string
# Steps to get this:
#   1. Go to https://cloud.mongodb.com
#   2. Create a free M0 cluster
#   3. Database Access → Add a user with a password
#   4. Network Access → Add 0.0.0.0/0 (allow all IPs)
#   5. Connect → "Connect your application" → copy the URI
#   6. Replace <password> below with your actual password
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/billmate?retryWrites=true&w=majority
